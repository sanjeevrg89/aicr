{
  "annotations": {
    "list": []
  },
  "description": "AICR Recipe Compliance and Configuration Drift Monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Fleet Compliance Overview",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "count(aicr_node_compliant == 1) or vector(0)",
          "legendFormat": "Compliant Nodes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Non-Compliant Nodes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "count(aicr_node_compliant == 0) or vector(0)",
          "legendFormat": "Non-Compliant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Constraints Failed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "aicr_drift_constraints_failed",
          "legendFormat": "Failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "title": "Components Drifted",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "aicr_drift_components_drifted",
          "legendFormat": "Drifted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Per-Node Compliance Status",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "aicr_node_compliant",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "node": "Node",
              "Value": "Compliant (1=yes, 0=no)"
            }
          }
        }
      ]
    },
    {
      "title": "Constraint Status by Name",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "aicr_recipe_constraint_status",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "name": "Constraint",
              "severity": "Severity",
              "Value": "Status (1=pass, 0=fail, -1=error)"
            }
          }
        }
      ]
    },
    {
      "title": "Component Drift Status",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "aicr_component_drift_status",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "component": "Component",
              "namespace": "Namespace",
              "Value": "Status (1=ok, 0=mismatch, -1=not-observed)"
            }
          }
        }
      ]
    },
    {
      "title": "Drift Check Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "rate(aicr_drift_check_total[5m])",
          "legendFormat": "{{mode}} — {{result}}"
        }
      ]
    },
    {
      "title": "Fleet Validation Duration (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(aicr_node_validation_duration_seconds_bucket[5m]))",
          "legendFormat": "fleet p99"
        },
        {
          "expr": "histogram_quantile(0.5, rate(aicr_node_validation_duration_seconds_bucket[5m]))",
          "legendFormat": "fleet p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Fleet Constraint Failure Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "rate(aicr_node_constraints_failed_total[5m])",
          "legendFormat": "failures/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      }
    },
    {
      "title": "Non-Compliant Nodes (drill-down via aicr_node_compliant{node})",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "aicr_node_compliant == 0",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ],
      "description": "The aicr_node_compliant gauge is the only metric carrying a {node} label (bounded by fleet size). Counters and histograms are fleet-aggregated for federation safety. For per-constraint detail, see the rate-limited Kubernetes Events with reason=RecipeNonCompliant."
    }
  ],
  "schemaVersion": 39,
  "tags": ["aicr", "gpu", "compliance", "drift"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "AICR Recipe Compliance & Drift",
  "uid": "aicr-compliance-drift"
}
